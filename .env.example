# Copy to .env and fill in real values. Never commit .env with real secrets.

NODE_ENV=development
PORT=3000

# MongoDB connection string (provide your own — Atlas, self-hosted, etc.)
MONGODB_URI=mongodb://localhost:27017/solis-field-tracker

# JWT signing secrets — must each be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Domain the auth cookies are scoped to (omit for localhost development)
COOKIE_DOMAIN=

# Origin the Next.js UI is served from (must match exactly — enableCors + credentials:true)
CORS_ORIGIN=http://localhost:3000

# Resend (https://resend.com) sends team-invite emails. Get a key from the
# Resend dashboard — the key below is Resend's own sandbox sender, which
# works with no domain verification but is for testing only.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Gmail inbox ingestion (optional — feature no-ops if unset). Self-service
# per org: an org_admin clicks "Connect Gmail" under Automations >
# Integrations, which starts an OAuth consent flow; the connected inbox,
# department and keywords are then stored per-org in the database, not
# here. These two are the shared Google Cloud OAuth app credentials (one
# project, type "Web application", Gmail API enabled) that every org's
# connect flow uses. GMAIL_OAUTH_REDIRECT_URI must exactly match an
# "Authorized redirect URI" on that OAuth client, e.g.
# http://localhost:4000/v1/integrations/gmail/callback for local dev.
# While the OAuth consent screen is in "Testing" mode, each Google account
# that will click "Connect Gmail" must also be added as a test user.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:4000/v1/integrations/gmail/callback
GMAIL_POLL_INTERVAL_MINUTES=5
